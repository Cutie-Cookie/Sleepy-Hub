<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Theme.BlackBox" parent="Theme.MaterialComponents.Light.NoActionBar">
        
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        

        <item name="actionMenuTextColor">@color/primary_text</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.BlackBox.Dark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#FFBDBDBD</item>
        <item name="colorPrimaryVariant">#FF424242</item>
        <item name="colorOnPrimary">#FF111111</item>
        <item name="colorSecondary">#FFBDBDBD</item>
        <item name="colorSecondaryVariant">#FF757575</item>
        <item name="colorOnSecondary">#FF111111</item>
        <item name="colorSurface">#FF1C1C1E</item>
        <item name="colorOnSurface">#FFF2F2F2</item>
        <item name="android:colorBackground">#FF121212</item>
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.BlackBox.Amoled" parent="Theme.BlackBox.Dark">
        <item name="colorSurface">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:windowBackground">#FF000000</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="actionMenuTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

</resources>